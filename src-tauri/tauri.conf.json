{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Polyhedron Explorer",
  "version": "0.1.0",
  "identifier": "app.stormlab.polyhedronexplorer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Polyhedron Explorer",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Explore the famous polyhedra in 3D",
    "longDescription": "Browse and explore hundreds of polyhedra: Platonic, Archimedean, Kepler-Poinsot, Johnson solids, Catalan duals, prisms, antiprisms, compounds and geodesic spheres.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
